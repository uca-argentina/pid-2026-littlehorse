<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure implements the ports Application declares, so the arrow
    points this way. Application must never reference Infrastructure back.
  -->
  <ItemGroup>
    <!--
      Implementations here stay internal so the only way to reach them is
      through their Application interface, registered in the composition root.
      Tests are the one exception.
    -->
    <InternalsVisibleTo Include="DrinkIt.Infrastructure.Tests" />
    <InternalsVisibleTo Include="DrinkIt.Api.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DrinkIt.Application/DrinkIt.Application.csproj" />
  </ItemGroup>

</Project>
