<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure implements the ports Application declares, so the arrow
    points this way. Application must never reference Infrastructure back.
  -->
  <ItemGroup>
    <!--
      Implementations here stay internal so the only way to reach them is
      through their Application interface, registered in the composition root.
      Tests are the one exception.
    -->
    <InternalsVisibleTo Include="DrinkIt.Infrastructure.Tests" />
    <InternalsVisibleTo Include="DrinkIt.Api.IntegrationTests" />
  </ItemGroup>

  <!--
    A plain class library does not pull in ASP.NET Core on its own. KdsHub
    (US-15) needs Microsoft.AspNetCore.SignalR, which lives in this shared
    framework — part of the .NET SDK itself, not a third-party dependency, so
    the "only free libraries" rule in CLAUDE.md does not apply to it.

    It also carries Microsoft.Extensions.Configuration.Json,
    Microsoft.Extensions.Configuration.EnvironmentVariables and
    Microsoft.Extensions.Identity.Core, which is why those three stopped being
    their own PackageReference below: NuGet refuses to list a package twice.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Azure.Storage.Blobs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DrinkIt.Application/DrinkIt.Application.csproj" />
  </ItemGroup>

</Project>
