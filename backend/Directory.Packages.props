<Project>

  <!--
    Central Package Management: package versions live here, and only here.
    A .csproj references a package by name, never with a Version attribute.

    Every version listed below must be free and open source for commercial
    use (MIT, Apache-2.0, BSD). See CLAUDE.md.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Security">
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.3" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
  </ItemGroup>

  <!--
    US-24: Mercado Pago's official .NET SDK, for Checkout Pro. MIT, published by
    Mercado Pago (github.com/mercadopago/dx-dotnet). The package id is
    "mercadopago-sdk": the bare "MercadoPago" id on NuGet is an unrelated,
    unlicensed package from 2012.
  -->
  <ItemGroup Label="Payments">
    <PackageVersion Include="mercadopago-sdk" Version="3.7.0" />
  </ItemGroup>

  <!-- Product pictures. MIT, like the Azurite emulator that stands in for it locally. -->
  <ItemGroup Label="Storage">
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.29.2" />
  </ItemGroup>

  <!-- Referenced by tests/Directory.Build.props, not by individual test projects. -->
  <ItemGroup Label="Testing">
    <PackageVersion Include="Testcontainers.MsSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.Azurite" Version="4.14.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <!--
    US-15's KDS hub isolation test: the first place this repo spins up the
    whole app (WebApplicationFactory) and drives it with a real SignalR
    client. Both MIT, same publisher as the rest of ASP.NET Core.
  -->
  <ItemGroup Label="Real-time testing">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
  </ItemGroup>

</Project>
