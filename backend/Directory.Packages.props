<Project>

  <!--
    Central Package Management: every NuGet package version is declared exactly
    once, here. The .csproj files reference packages by name, with no version.

    Why from the start: it stops Application from using xUnit 2.9 while Domain
    uses 2.8 without anyone noticing, and it leaves a single list to audit for
    licences (see the free-libraries rule in CLAUDE.md). Migrating to it later
    means editing every .csproj.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Testing">
    <!-- All MIT or Apache-2.0. Pulled in by tests/Directory.Build.props. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

</Project>
