<Project>

  <!--
    Central Package Management: package versions live here, and only here.
    A .csproj references a package by name, never with a Version attribute.

    Every version listed below must be free and open source for commercial
    use (MIT, Apache-2.0, BSD). See CLAUDE.md.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Security">
    <!-- Transitive, via Microsoft.Data.SqlClient. Pinned to 10.0.13, the first patched version, for GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7. Drop it once SqlClient brings a patched one. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.0" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
  </ItemGroup>

  <!-- Product pictures. MIT, like the Azurite emulator that stands in for it locally. -->
  <ItemGroup Label="Storage">
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
  </ItemGroup>

  <!-- Referenced by tests/Directory.Build.props, not by individual test projects. -->
  <ItemGroup Label="Testing">
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Azurite" Version="4.16.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>

  <!--
    US-15's KDS hub isolation test: the first place this repo spins up the
    whole app (WebApplicationFactory) and drives it with a real SignalR
    client. Both MIT, same publisher as the rest of ASP.NET Core.
  -->
  <ItemGroup Label="Real-time testing">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
  </ItemGroup>

</Project>
