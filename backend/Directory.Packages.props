<Project>

  <!--
    Central Package Management: every NuGet package version is declared exactly
    once, here. The .csproj files reference packages by name, with no version.

    Why from the start: it stops Application from using xUnit 2.9 while Domain
    uses 2.8 without anyone noticing, and it leaves a single list to audit for
    licences (see the free-libraries rule in CLAUDE.md). Migrating to it later
    means editing every .csproj.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- No packages yet. They get added here as they are needed. -->
  </ItemGroup>

</Project>
