# Normalises line endings across the repository.
# Without this, one teammate on Windows and another on macOS produce whole-file
# diffs every time they save, which makes PR review useless.
* text=auto eol=lf

# Source code and configuration: always LF.
*.cs      text eol=lf diff=csharp
*.csproj  text eol=lf
*.props   text eol=lf
*.targets text eol=lf
*.ts      text eol=lf
*.js      text eol=lf
*.html    text eol=lf
*.scss    text eol=lf
*.css     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.bicep   text eol=lf
*.sh      text eol=lf

# Windows-native tooling that expects CRLF.
*.sln     text eol=crlf
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binaries: git leaves them alone.
*.pdf     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.ico     binary
*.webp    binary
*.woff    binary
*.woff2   binary
