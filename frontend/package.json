{
  "name": "frontend",
  "version": "0.0.0",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint && stylelint \"src/**/*.scss\"",
    "lint:fix": "ng lint --fix && stylelint \"src/**/*.scss\" --fix",
    "test:ci": "ng test --watch=false",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:api": "curl -sSf https://localhost:7176/openapi/v1.json -o openapi.json && openapi-typescript openapi.json -o src/app/core/api/schema.d.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@angular/service-worker": "^22.2.2",
    "@microsoft/signalr": "^10.0.11",
    "angularx-qrcode": "^22.0.1",
    "barcode-detector": "^3.2.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zxing-wasm": "3.1.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/angular": "^19.5.0",
    "@types/node": "^26.6.5",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "^5.0.4"
  }
}
